{
  "name": "jev-usher",
  "version": "0.1.0",
  "description": "JEV-powered model routing and recoverable context filtering for Claude Code, with a local comparison UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "bin",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "llms.txt",
    "docs/architecture.md",
    "docs/claude-code.md",
    "docs/local-ui.md",
    "docs/privacy.md",
    "docs/reference.md",
    "docs/results.md",
    "hooks",
    "ui",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test && npm run build",
    "eval:live": "npm run build && node scripts/evaluate.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "eval:claude": "npm run build && node scripts/evaluate-claude.mjs"
  },
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "context",
    "tokens",
    "rerank",
    "agents",
    "claude",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cvsgireesh/jev-usher.git"
  },
  "homepage": "https://github.com/cvsgireesh/jev-usher#readme",
  "bugs": {
    "url": "https://github.com/cvsgireesh/jev-usher/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "jev-usher": "./bin/jev-usher.mjs",
    "jevusher": "./bin/jevusher.mjs"
  }
}
