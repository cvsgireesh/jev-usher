{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/jev-usher.mjs\" hook user-prompt-submit",
        "timeout": 20
      }]
    }],
    "PreToolUse": [{
      "matcher": "^(Edit|Write)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/jev-usher.mjs\" hook pre-tool-use",
        "timeout": 20
      }]
    }],
    "PostToolUse": [{
      "matcher": "^(Read|Bash|Grep|Glob|WebFetch|WebSearch|mcp__.*)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/jev-usher.mjs\" hook post-tool-use",
        "timeout": 20
      }]
    }]
  }
}
